generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  HIRER
  ADMIN
}

enum TransactionType {
  INITIAL_BONUS
  JOB_SEARCH
  JOB_SUBMISSION_REWARD
  ADMIN_ADJUSTMENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             Role              @default(USER)
  coins            Int               @default(100)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          CandidateProfile?
  coinTransactions CoinTransaction[]
  createdJobs      Job[]             @relation("UserCreatedJobs")
  applications     Application[]
}

model CoinTransaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int             // e.g. +100, -10, +5
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())
}

model CandidateProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String?
  email                String?
  phone                String?
  education            Json?
  graduationYear       Int?
  skills               String[]
  programmingLanguages String[]
  frameworks           String[]
  databases            String[]
  tools                String[]
  projects             Json?
  experience           Json?
  certifications       String[]
  preferredRoles       String[]
  preferredLocations   String[]
  rawText              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Job {
  id                 String             @id @default(uuid())
  title              String
  company            String
  description        String?
  location           String?
  jobType            String?            // e.g. "INTERNSHIP", "FULL_TIME"
  experienceLevel    String?
  skills             String[]
  eligibility        String?
  graduationYears    Int[]
  applicationUrl     String             @unique
  sourceUrl          String?
  sourceType         String             @default("GEMINI") // "GEMINI", "USER", "HIRER"
  isActive           Boolean            @default(true)
  verificationStatus VerificationStatus @default(VERIFIED)
  lastVerifiedAt     DateTime?
  postedDate         DateTime?
  deadline           DateTime?
  createdById        String?
  createdBy          User?              @relation("UserCreatedJobs", fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  applications       Application[]
}

model Application {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(SAVED)
  notes      String?
  appliedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, jobId])
}
